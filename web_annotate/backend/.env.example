# Neon PostgreSQL — paste the pooled connection string from the Neon console.
# (Alternatively set PG_USER / PG_PASS / PG_HOST / PG_PORT / PG_NAME and the
#  server will assemble the URL itself, like backend/.env already does.)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# The code raters type on the login screen, together with their name.
ACCESS_CODE=

# Signs the session token. Any long random string; changing it logs everyone
# out (their saved ratings are untouched — they just log in again).
SESSION_SECRET=

# Guards /api/admin/* (progress dashboard + CSV export). Leave empty to
# disable those routes entirely.
ADMIN_KEY=

# Typing this into the login form's access-code field (no name needed) opens
# the /admin progress dashboard instead of the rating flow. Also accepted as
# the ?key= for /api/admin/*. Leave empty to disable.
ADMIN_CODE=

# Comma-separated allowed origins. Set this to the Vercel URL before sharing
# the link; leave unset to allow any origin while testing locally.
# CORS_ORIGIN=https://itc-annotate.vercel.app

PORT=8787
