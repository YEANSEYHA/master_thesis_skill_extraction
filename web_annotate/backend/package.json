{
  "name": "annotate-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the ITC multi-rater curriculum-alignment study (250 frozen pairs, 0-10)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
