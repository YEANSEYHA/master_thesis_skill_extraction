# Copy to backend/.env and fill in the values you need. Every phase reads this
# one file. Only the keys used by the step you run are required.

# PostgreSQL (job_sites, discovery_log, stored syllabi and curriculum skills)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASS=
PG_NAME=
PG_SSLMODE=prefer          # "require" for hosted DBs (Neon, Supabase, ...), "prefer" works for local

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=        # Phase 3 classification (Llama 3.1 8B) and extraction (Qwen3-14B)
ZHIPU_API_KEY=
deekseek_api=              # Phase 2 URL-taxonomy learning (DeepSeek)
ACTIVE_MODEL=              # Phase 1 discovery model
PHASE5_LLM_MODEL=          # Phase 5 curriculum skill extraction model
MODE=

# Phase 1 search APIs
SERPAPI_KEY=
BING_API_KEY=
BING_API_ENDPOINT=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional development scraper
SCRAPERAPI_KEY=

# Phase 2 proxy (optional)
OXYLABS_USER=
OXYLABS_PASS=

# Cloudflare R2 (raw HTML and original syllabus archive)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
